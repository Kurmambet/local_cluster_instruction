# Managed by Ansible. Файл 10-* обрабатывается раньше 50-cloud-init.conf,
# а в sshd побеждает первое найденное значение параметра.
PermitRootLogin {{ ssh_permit_root_login }}
PasswordAuthentication {{ ssh_password_authentication }}
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
MaxAuthTries {{ ssh_max_auth_tries }}
LoginGraceTime {{ ssh_login_grace_time }}
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}
X11Forwarding no
AllowUsers {{ ssh_allow_users | join(' ') }}
# AllowTcpForwarding оставлен включённым: через ssh -L удобно ходить
# к Grafana/Prometheus, которые слушают только 127.0.0.1.
