# Managed by Ansible. Этот файл подключается внутри блока http {}.
server_tokens off;

# Для WebSocket: если Upgrade не пришёл, Connection = close
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Лимит запросов по IP (используется в location с rate_limit: true)
limit_req_zone $binary_remote_addr zone=perip:10m rate={{ nginx_limit_req_rate }};

gzip_comp_level 5;
gzip_min_length 512;
gzip_proxied any;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

{% if nginx_catch_all | bool %}
# Запросы по IP или с чужим Host — сбрасываем
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl{{ '' if nginx_use_http2_directive else ' http2' }} default_server;
    listen [::]:443 ssl{{ '' if nginx_use_http2_directive else ' http2' }} default_server;
    server_name _;
    ssl_reject_handshake on;
}
{% endif %}
