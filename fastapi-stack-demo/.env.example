# ТОЛЬКО для локальной разработки. Скопируй в src/.env (файл в .gitignore).
# В проде этого файла нет: переменные приходят из shared/compose.env и shared/api.env,
# которые создаёт Ansible из vault (см. README).

# ===== backend (префикс FASTAPI_) =====
FASTAPI_APP_ENV=local
FASTAPI_DEBUG=true
FASTAPI_JWT_SECRET_KEY=dev-only-secret-key-change-me-0123456789
FASTAPI_JWT_ALGORITHM=HS256
FASTAPI_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
FASTAPI_CORS_ORIGINS=["http://localhost:5173"]
# ===== postgres =====
FASTAPI_POSTGRES_DB=demo
FASTAPI_POSTGRES_USER=demo
FASTAPI_POSTGRES_PASSWORD=demo
FASTAPI_POSTGRES_HOST=localhost
FASTAPI_POSTGRES_PORT=5432
FASTAPI_DATABASE_POOL_SIZE=5
FASTAPI_DATABASE_MAX_OVERFLOW=5
FASTAPI_SQL_ECHO=false
# ===== redis =====
FASTAPI_REDIS_HOST=localhost
FASTAPI_REDIS_PORT=6379
FASTAPI_REDIS_PASSWORD=demo
# ===== grafana =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000/grafana/


# ===== frontend (ПУБЛИЧНО, без секретов) =====
# Только для `npm run dev`.
# В проде значение приходит как build-arg VITE_API_BASE_URL при сборке образа (по умолчанию /api).

VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws/counter
